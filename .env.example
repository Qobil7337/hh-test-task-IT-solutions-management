# Docker Compose configuration for the CharityHub development environment.
# Copy to `.env` (same folder). Every variable has a default, so the stack also
# starts without this file.

# PostgreSQL
POSTGRES_USER=charityhub
POSTGRES_PASSWORD=charityhub
POSTGRES_DB=charityhub
# Host port the database is exposed on
POSTGRES_PORT=5432

# Host ports for the apps
BACKEND_PORT=3000
FRONTEND_PORT=3001

# Backend (NestJS API)
# development | production | test — development enables the Apollo sandbox
NODE_ENV=development
# Secret for signing JWTs (min 16 chars). Use a long random value outside local dev.
JWT_SECRET=dev-only-secret-change-me-in-production
JWT_EXPIRES_IN=1h
# Run the (idempotent) development seed after migrations on every start
SEED_DATABASE=true
