# Application
# One of: development | production | test
NODE_ENV=development
PORT=3000

# PostgreSQL (used by docker-compose.yml to provision the local database)
POSTGRES_USER=charityhub
POSTGRES_PASSWORD=charityhub
POSTGRES_DB=charityhub
# Host port the database is exposed on
POSTGRES_PORT=5432

# PostgreSQL connection string used by Prisma.
# Must match the POSTGRES_* values above:
# postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:<POSTGRES_PORT>/<POSTGRES_DB>?schema=public
DATABASE_URL=postgresql://charityhub:charityhub@localhost:5432/charityhub?schema=public
